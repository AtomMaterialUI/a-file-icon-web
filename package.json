{
  "name": "atom-material-icons-web",
  "version": "14.1.0",
  "description": "Atom Material Icons for Web",
  "author": "Elior Boukhobza <heliosaian@gmail.com>",
  "license": "MIT",
  "scripts": {
    "preconvert": "rimraf public",
    "convert": "npm --prefix iconGenerator run convert",
    "prepare": "bun run scripts/prepare.ts",
    "prebuild": "bun run prepare",
    "build": "bun run plasmo:build",
    "build:firefox": "bun run plasmo:build --target=firefox-mv2",
    "predev": "bun run prepare",
    "dev": "bun run plasmo:dev",
    "dev:firefox": "bun run plasmo:dev --target=firefox-mv2",
    "plasmo:dev": "plasmo dev",
    "plasmo:build": "plasmo build --zip",
    "plasmo:buddy": "plasmo build --source-maps --bundle-buddy",
    "package": "plasmo package",
    "package:firefox": "plasmo package --target=firefox-mv2",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check src",
    "test": "bun test",
    "release:patch": "npm version patch -m \"chore: release v%s\"",
    "release:minor": "npm version minor -m \"chore: release v%s\"",
    "release:major": "npm version major -m \"chore: release v%s\"",
    "postversion": "git push --follow-tags && gh release create v$npm_package_version --title v$npm_package_version --generate-notes --verify-tag",
    "refreshtoken": "gcp-refresh-token"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@plasmohq/storage": "^1.15.0",
    "browserslist": "^4.25.1",
    "caniuse-lite": "^1.0.30001806",
    "lodash.capitalize": "^4.2.1",
    "lodash.debounce": "4.0.8",
    "plasmo": "0.90.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "select-dom": "9.4.0",
    "sirv": "3.0.1",
    "sirv-cli": "3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@ianvs/prettier-plugin-sort-imports": "4.5.1",
    "@parcel/runtime-js": "^2.15.4",
    "@types/bun": "1.2.19",
    "@types/chrome": "0.1.1",
    "@types/node": "24.1.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "compression": "1.8.1",
    "gcp-refresh-token": "^0.9.2",
    "polka": "0.5.2",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "5.8.3"
  },
  "manifest": {
    "name": "Atom Material Icons",
    "description": "Atom Material Icons for Web (GitHub, BitBucket, Gitee, Azure and GitLab)",
    "author": "Elior Boukhobza (Mallowigi)",
    "homepage_url": "https://www.material-theme.com",
    "permissions": [
      "storage"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "{f0503c92-a634-43fd-912d-63c8fde00586}"
      }
    },
    "host_permissions": [
      "http://github.com/*",
      "https://github.com/*",
      "http://bitbucket.org/*",
      "https://bitbucket.org/*",
      "http://gitlab.com/*",
      "https://gitlab.com/*",
      "http://gitee.com/*",
      "https://gitee.com/*",
      "http://dev.azure.com/*",
      "https://dev.azure.com/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/packs/*.svg"
        ],
        "matches": [
          "http://github.com/*",
          "https://github.com/*",
          "http://bitbucket.org/*",
          "https://bitbucket.org/*",
          "http://gitlab.com/*",
          "https://gitlab.com/*",
          "http://gitee.com/*",
          "https://gitee.com/*",
          "http://dev.azure.com/*",
          "https://dev.azure.com/*"
        ]
      }
    ]
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
