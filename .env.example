# ---------------------------------------------------------------------------
# Release credentials (dotenvx source of truth)
#
# Copy this file to `.env`, fill in the real values, then encrypt it:
#
#     bunx @dotenvx/dotenvx encrypt
#
# That rewrites `.env` with encrypted values (safe to commit) and creates
# `.env.keys` holding DOTENV_PRIVATE_KEY (NEVER commit `.env.keys`).
# Put the DOTENV_PRIVATE_KEY value into the GitHub Actions secret of the same
# name if/when you move CI off SUBMIT_KEYS (see RELEASE.md, Option B2).
#
# See RELEASE.md for the full flow. These map 1:1 to key.json / keys.json.
# ---------------------------------------------------------------------------

# --- GCP OAuth client (the `installed` block of key.json) ------------------
GCP_CLIENT_ID="YOUR_GCP_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GCP_CLIENT_SECRET="YOUR_GCP_OAUTH_CLIENT_SECRET"
GCP_PROJECT_ID="your-gcp-project-id"
GCP_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
GCP_TOKEN_URI="https://oauth2.googleapis.com/token"
GCP_AUTH_PROVIDER_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
GCP_REDIRECT_URIS="http://localhost"

# --- Chrome Web Store (bpp `chrome`) ---------------------------------------
# CHROME_CLIENT_ID / CHROME_CLIENT_SECRET default to the GCP_* values above.
CHROME_CLIENT_ID=""
CHROME_CLIENT_SECRET=""
# Minted by `bun run release -- --refresh` (gcp-refresh-token). Leave blank
# on first setup; the script writes it back here (re-encrypted).
CHROME_REFRESH_TOKEN=""
CHROME_EXT_ID="YOUR_CHROME_EXTENSION_ID"

# --- Firefox Add-ons (bpp `firefox`) ---------------------------------------
FIREFOX_API_KEY="user:0000000:000"
FIREFOX_API_SECRET="YOUR_FIREFOX_API_SECRET"
FIREFOX_EXT_ID="{00000000-0000-0000-0000-000000000000}"

# --- Edge Add-ons (bpp `edge`) ---------------------------------------------
EDGE_PRODUCT_ID="00000000-0000-0000-0000-000000000000"
EDGE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
EDGE_CLIENT_SECRET="YOUR_EDGE_CLIENT_SECRET"
EDGE_ACCESS_TOKEN_URL="https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/token"
